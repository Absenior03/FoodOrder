# Render Backend Environment Variables
# Copy these to your Render dashboard under Environment Variables

# Server Configuration
NODE_ENV=production
PORT=10000

# Database - Get from MongoDB Atlas
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/food_ordering?retryWrites=true&w=majority

# Authentication - Generate a secure random string (min 32 characters)
JWT_SECRET=your-super-secure-jwt-secret-key-at-least-32-characters-long
BCRYPT_SALT_ROUNDS=12

# CORS - Replace with your actual Vercel URL
CORS_ORIGIN=https://your-app-name.vercel.app
FRONTEND_URL=https://your-app-name.vercel.app
ALLOWED_ORIGINS=https://your-app-name.vercel.app

# Optional: Redis (if you add Redis on Render)
# REDIS_URL=redis://red-xxxxx:6379

# Optional: Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
