{
  "name": "backend",
  "version": "1.0.0",
  "description": "Food Ordering Platform Backend",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc --skipLibCheck --noEmit false",
    "build:dev": "tsc",
    "start": "node dist/index.js",
