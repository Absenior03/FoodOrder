    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "seed:inventory": "ts-node src/scripts/seedInventory.ts",
    "seed:inventory:clear": "ts-node src/scripts/seedInventory.ts --clear",
    "cart:cleanup": "ts-node src/scripts/cartCleanup.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.10.0",
    "@types/socket.io": "^3.0.1",
    "@types/uuid": "^10.0.0",
    "@types/validator": "^13.15.4",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-validator": "^7.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.19.3",
    "redis": "^5.9.0",
    "socket.io": "^4.8.1",
    "typescript": "^5.9.3",
    "uuid": "^13.0.0",
    "validator": "^13.15.20"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/supertest": "^6.0.3",
    "jest": "^30.2.0",
    "mongodb-memory-server": "^10.3.0",
    "nodemon": "^3.1.10",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2"
