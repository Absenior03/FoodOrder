# Frontend Production Environment Variables
# These variables are embedded into the build at compile time

# API Configuration
REACT_APP_API_URL=https://api.yourdomain.com/api
REACT_APP_WEBSOCKET_URL=https://api.yourdomain.com

# Application Configuration
REACT_APP_ENVIRONMENT=production
REACT_APP_VERSION=1.0.0
REACT_APP_APP_NAME=Food Ordering Platform

# Feature Flags
REACT_APP_ENABLE_ANALYTICS=true
REACT_APP_ENABLE_ERROR_REPORTING=true
REACT_APP_ENABLE_PERFORMANCE_MONITORING=true

# Third-party Services
REACT_APP_GOOGLE_ANALYTICS_ID=GA-XXXXXXXXX
REACT_APP_SENTRY_DSN=your-frontend-sentry-dsn
REACT_APP_HOTJAR_ID=your-hotjar-id

# CDN Configuration
REACT_APP_CDN_URL=https://cdn.yourdomain.com
REACT_APP_IMAGES_BASE_URL=https://images.yourdomain.com

# Social Media
REACT_APP_FACEBOOK_APP_ID=your-facebook-app-id
REACT_APP_GOOGLE_CLIENT_ID=your-google-client-id

# Map Services (if implemented)
REACT_APP_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Payment Services (if implemented)
REACT_APP_STRIPE_PUBLISHABLE_KEY=pk_live_your-stripe-key
REACT_APP_PAYPAL_CLIENT_ID=your-paypal-client-id

# Security
REACT_APP_RECAPTCHA_SITE_KEY=your-recaptcha-site-key

# Build Configuration
GENERATE_SOURCEMAP=false
INLINE_RUNTIME_CHUNK=false